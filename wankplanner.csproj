<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe allows both the Photino GUI and headless CLI (--log) to function -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- CRITICAL FOR GITHUB ACTIONS: 
         Ensures native Photino webview bindings (WebView2/WebKitGTK) 
         and SQLite native binaries (e_sqlite3) are bundled into the single executable 
         and extracted properly at runtime. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Prevents the compiler from stripping Photino components during publish -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Update version numbers to match your current packages if necessary -->
    <PackageReference Include="Photino.NET" Version="3.1.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="QuestPDF" Version="2023.12.6" />
  </ItemGroup>

  <!-- Ensures your HTML/CSS/JS frontend files are copied to the build/publish output -->
  <ItemGroup>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
